<UserControl x:Class="CyberManager.UI.Views.DiskPerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CyberManager.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="GraphCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemFrame" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource SelectionBgBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="DiskScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="420" Height="{Binding ViewportHeight, ElementName=DiskScroll}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Heading" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="ActiveValue" FontSize="18" FontWeight="SemiBold" Foreground="#10B981" Margin="12,0,0,0"/>
            </StackPanel>
            <ComboBox x:Name="DiskSelector" Grid.Column="1" MinWidth="230" MaxWidth="340" Height="34"
                      SelectedValuePath="Id" SelectionChanged="DiskSelector_SelectionChanged"
                      Foreground="{DynamicResource TextBrush}" FontSize="12">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                <ComboBox.Template><ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"/>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,30,0"/>
                        <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource SubTextBrush}" Width="8" Height="4" Stretch="Fill"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="0,4,0,0">
                                <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate></ComboBox.Template>
            </ComboBox>
        </Grid>
        <TextBlock x:Name="ScopeHint" Grid.Row="1" Style="{StaticResource MetricLabel}" TextWrapping="Wrap" Margin="0,6,0,10"/>
        <Grid Grid.Row="2">
            <Grid x:Name="Graphs">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource GraphCard}" Margin="0,0,0,8">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="ActiveHistoryLabel" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/>
                        <controls:LargeHistoryGraphControl x:Name="ActiveGraph" Grid.Row="1" ShowMeter="False" MaxSamples="120" MaxValue="100" UnitSuffix="%" PrimaryColor="#10B981" MinHeight="90"
                                                           PlotBackground="{DynamicResource InputBgBrush}" PlotGridBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource GraphCard}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock x:Name="TransferScale" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource MetricLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TransferLabel" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,12,0"/>
                                <TextBlock x:Name="ReadLegend" Foreground="#10B981" FontSize="11" Margin="0,0,12,0"/>
                                <TextBlock x:Name="WriteLegend" Foreground="#EF4444" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                        <controls:LargeHistoryGraphControl x:Name="TransferGraph" Grid.Row="1" ShowMeter="False" MaxSamples="120" UnitSuffix="MB/s" PrimaryColor="#10B981" SecondaryColor="#EF4444" MinHeight="90"
                                                           PlotBackground="{DynamicResource InputBgBrush}" PlotGridBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540" Foreground="{DynamicResource SubTextBrush}" FontSize="14"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <UniformGrid Columns="4">
                <StackPanel Margin="6,4"><TextBlock x:Name="ReadLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ReadValue" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Margin="6,4"><TextBlock x:Name="WriteLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="WriteValue" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Margin="6,4"><TextBlock x:Name="ResponseLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ResponseValue" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Margin="6,4"><TextBlock x:Name="QueueLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="QueueValue" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Margin="6,4"><TextBlock x:Name="TotalReadLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TotalReadValue" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Margin="6,4"><TextBlock x:Name="TotalWriteLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="TotalWriteValue" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Margin="6,4"><TextBlock x:Name="OperationsLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="OperationsValue" Style="{StaticResource MetricValue}"/></StackPanel>
                <StackPanel Margin="6,4"><TextBlock x:Name="DiskCountLabel" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="DiskCountValue" Style="{StaticResource MetricValue}"/></StackPanel>
            </UniformGrid>
            <TextBlock x:Name="HistoryHint" Style="{StaticResource MetricLabel}" Margin="6,4,0,0"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
