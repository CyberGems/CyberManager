<Window x:Class="CyberManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CyberManager.UI.Services"
        xmlns:controls="clr-namespace:CyberManager.UI.Controls"
        Title="CyberManager — Ultra-Light Task Manager" Height="700" Width="1100" MinHeight="520" MinWidth="900"
        Icon="pack://application:,,,/Assets/CyberManager.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:ChildIndentMarginConverter x:Key="ChildIndentMarginConverter"/>
        <conv:ExpandedChevronConverter x:Key="ExpandedChevronConverter"/>
        <conv:ParentFontWeightConverter x:Key="ParentFontWeightConverter"/>
        <conv:WorkerBadgeVisibilityConverter x:Key="WorkerBadgeVisibilityConverter"/>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
        <conv:CpuHeatmapBrushConverter x:Key="CpuHeatmapBrushConverter"/>
        <conv:MemoryHeatmapBrushConverter x:Key="MemoryHeatmapBrushConverter"/>
        <conv:HighCpuWeightConverter x:Key="HighCpuWeightConverter"/>
        <conv:HighMemoryWeightConverter x:Key="HighMemoryWeightConverter"/>
        <conv:SystemProcessIconConverter x:Key="SystemProcessIconConverter"/>
        <conv:ProcessDescriptionConverter x:Key="ProcessDescriptionConverter"/>

        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerModernButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E81123"/>
                                <Setter TargetName="Bd" Property="Background" Value="#22E81123"/>
                                <Setter Property="Foreground" Value="#FF6B6B"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.10" ScaleY="1.10"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.90" ScaleY="0.90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="11"/><Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- Hover highlight overlay -->
                                <Border x:Name="HoverOverlay" Background="{DynamicResource BorderBrush}" Opacity="0" CornerRadius="0"/>
                                <!-- Bottom accent line on hover -->
                                <Border x:Name="AccentLine" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <!-- Sort arrow indicator -->
                                    <Path x:Name="SortArrow" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}"
                                          Data="M 0 0 L 4 5 L 8 0 Z" Width="8" Height="5" Stretch="Uniform" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 5 L 4 0 L 8 5 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 5 L 8 0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="True"/>
                                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"/>
                                <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </SelectiveScrollingGrid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="1"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource GridAltBrush}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBgBrush}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0"/></Trigger>
                            <DataTrigger Binding="{Binding Status}" Value="Suspended">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger></Style.Triggers>
        </Style>
        <!-- CyberSnap Neon Glowing Toggle Switch Style -->
        <Style x:Key="CyberSnapToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.2"/>
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#94A3B8" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="3" ShadowDepth="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyStateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Border Margin="5" CornerRadius="12">
        <Border x:Name="OuterBorder" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}" ClipToBounds="True">
            <Grid Margin="20,14,20,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <!-- TitleBar -->
                <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/CyberManager.png" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CyberManager" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="NT ENGINE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="SubtitleText" Text="Premium • Virtualized • Zero-Lag for 3000+ processes" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="Transparent" CornerRadius="6" Padding="4,2" Cursor="Hand" MouseLeftButtonUp="SystemInfo_Click" ToolTip="Click to open System Information" Margin="0,0,10,0">
                            <TextBlock x:Name="StatsText" Text="—" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Click="ThemeToggle_Click" ToolTip="Theme"><TextBlock Text="🎨" FontSize="12"/></Button>
                        <Button Style="{StaticResource IconButton}" Click="LangToggle_Click" ToolTip="Language"><TextBlock Text="🌐" FontSize="12"/></Button>
                        <Button Style="{StaticResource TitleBtn}" Click="About_Click" ToolTip="About"><TextBlock Text="ⓘ" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
                        <Button Style="{StaticResource TitleBtn}" Click="Minimize_Click" ToolTip="Minimize"><TextBlock Text="—" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
                        <Button Style="{StaticResource TitleBtn}" Click="Maximize_Click" ToolTip="Maximize"><TextBlock Text="☐" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
                        <Button Style="{StaticResource TitleCloseBtn}" Click="Close_Click" ToolTip="Close"><TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
                    </StackPanel>
                </Grid>

                <!-- Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Background="{DynamicResource SearchBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" Foreground="{DynamicResource SubTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search process, PID or path..." Foreground="{DynamicResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,0"/>
                            <Button Grid.Column="2" Content="✕" Foreground="{DynamicResource SubTextBrush}" Background="Transparent" BorderThickness="0" FontSize="10" Cursor="Hand" Padding="6,0" Click="ClearSearch_Click" Visibility="Collapsed" x:Name="ClearBtn"/>
                        </Grid>
                    </Border>

                    <!-- CPU Sparkline Widget -->
                    <Border Grid.Column="1" x:Name="CpuSparklineBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="34" Margin="10,0,0,0" Padding="8,3,8,3" Cursor="Hand" MouseLeftButtonUp="SystemInfo_Click" ToolTip="CPU History (Click to open System Information)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="CpuSparklineText" Text="0.0%" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                            <controls:SparklineControl x:Name="CpuSparkline" Grid.Column="1" Width="85" Height="26"
                                                      StrokeBrush="#10B981"
                                                      FillBrush="#2010B981"
                                                      SecondaryStrokeBrush="#EF4444"
                                                      SecondaryFillBrush="#40EF4444"
                                                      Click="SystemInfo_Click"/>
                        </Grid>
                    </Border>

                    <!-- RAM Sparkline Widget -->
                    <Border Grid.Column="2" x:Name="RamSparklineBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="34" Margin="8,0,0,0" Padding="8,3,8,3" Cursor="Hand" MouseLeftButtonUp="SystemInfo_Click" ToolTip="Memory History (Click to open System Information)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="RAM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="RamSparklineText" Text="0.0 GB" FontSize="11" FontWeight="Bold" Foreground="#00E5FF"/>
                            </StackPanel>
                            <controls:SparklineControl x:Name="RamSparkline" Grid.Column="1" Width="85" Height="26"
                                                      StrokeBrush="#00E5FF"
                                                      FillBrush="#2000E5FF"
                                                      Click="SystemInfo_Click"/>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="RefreshBtn" Style="{StaticResource ModernButton}" Click="Refresh_Click" ToolTip="Refresh (F5)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 4 4 V 9 H 9 M 20 20 V 15 H 15 M 20 9 A 9 9 0 0 0 5.64 5.64 L 4 9 M 4 15 A 9 9 0 0 0 18.36 18.36 L 20 15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                <TextBlock x:Name="RefreshBtnText" Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="KillBtn" Style="{StaticResource DangerModernButton}" Margin="8,0,0,0" Click="Kill_Click" ToolTip="End Task (Del)" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 3 3 L 11 11 M 11 3 L 3 11" Stroke="#FF5252" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                <TextBlock x:Name="KillBtnText" Text="End Task" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="ProcGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="{DynamicResource CardBrush}" BorderThickness="0" RowHeaderWidth="0"
                                  AlternationCount="2" CanUserSortColumns="True" CanUserResizeColumns="True"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  Sorting="ProcGrid_Sorting"
                                  SelectionChanged="ProcGrid_SelectionChanged"
                                  PreviewKeyDown="ProcGrid_PreviewKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource ModernContextMenu}">
                                    <MenuItem Header="End Task" Style="{StaticResource ModernMenuItem}" Click="Kill_Click"/>
                                    <MenuItem Header="End Process Tree" Style="{StaticResource ModernMenuItem}" Click="KillTree_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Suspend" Style="{StaticResource ModernMenuItem}" Click="Suspend_Click"/>
                                    <MenuItem Header="Resume" Style="{StaticResource ModernMenuItem}" Click="Resume_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Set Priority" Style="{StaticResource ModernMenuItem}">
                                        <MenuItem Header="Real Time" Click="PriorityRealTime_Click"/>
                                        <MenuItem Header="High" Click="PriorityHigh_Click"/>
                                        <MenuItem Header="Above Normal" Click="PriorityAboveNormal_Click"/>
                                        <MenuItem Header="Normal" Click="PriorityNormal_Click"/>
                                        <MenuItem Header="Below Normal" Click="PriorityBelowNormal_Click"/>
                                        <MenuItem Header="Idle / Low" Click="PriorityIdle_Click"/>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Copy Path" Style="{StaticResource ModernMenuItem}" Click="CopyPath_Click"/>
                                    <MenuItem Header="Open Folder" Style="{StaticResource ModernMenuItem}" Click="OpenFolder_Click"/>
                                    <MenuItem Header="Search Online" Style="{StaticResource ModernMenuItem}" Click="SearchOnline_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Process" Width="260" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="{Binding IsGroupChild, Converter={StaticResource ChildIndentMarginConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <!-- Fixed 20px Slot for Expander / Hierarchy -->
                                                    <ColumnDefinition Width="20"/>
                                                    <!-- Fixed 22px Slot for Process Icon -->
                                                    <ColumnDefinition Width="22"/>
                                                    <!-- Process Name -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Badges -->
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Chevron button for Group Parents -->
                                                <Border Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding IsGroupParent, Converter={StaticResource BoolToVisConverter}}"
                                                        Cursor="Hand" Background="Transparent" MouseLeftButtonDown="GroupChevron_MouseDown"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding IsExpanded, Converter={StaticResource ExpandedChevronConverter}}"
                                                               Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Tree hierarchy indicator for Child -->
                                                <TextBlock Grid.Column="0" Text="↳" Foreground="{DynamicResource SubTextBrush}" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsGroupChild, Converter={StaticResource BoolToVisConverter}}"/>

                                                <!-- Process Icon Slot with fallback to system/diamond glyph -->
                                                <Grid Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image x:Name="ProcIcon" Source="{Binding ExePath, Converter={StaticResource PathToIconConverter}}"
                                                           Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Source" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource SystemProcessIconConverter}}"
                                                               Foreground="{DynamicResource SubTextBrush}" FontSize="10"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=ProcIcon, Path=Visibility}" Value="Collapsed">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Process Name -->
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="{Binding IsGroupParent, Converter={StaticResource ParentFontWeightConverter}}"
                                                           VerticalAlignment="Center" Margin="3,0,0,0" TextTrimming="CharacterEllipsis"/>

                                                <!-- Badges -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0">
                                                    <!-- Instance Count Badge for Group Parent -->
                                                    <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsGroupParent, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="{Binding InstanceCount}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>

                                                    <!-- Main Window UI Badge -->
                                                    <Border Background="#2000E5FF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="4,1" Margin="0,0,4,0" VerticalAlignment="Center"
                                                            ToolTip="{Binding MainWindowTitle}"
                                                            Visibility="{Binding HasWindow, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock Text="UI" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>

                                                    <!-- Worker Badge -->
                                                    <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                                                            Visibility="{Binding RoleBadge, Converter={StaticResource WorkerBadgeVisibilityConverter}}">
                                                        <TextBlock Text="Worker" FontSize="8.5" Foreground="{DynamicResource SubTextBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" SortMemberPath="Pid"/>
                                <DataGridTemplateColumn Header="CPU %" Width="85" SortMemberPath="CpuPercent" SortDirection="Descending">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CpuPercent, Converter={StaticResource CpuHeatmapBrushConverter}}"
                                                    CornerRadius="4" Margin="1,1" Padding="8,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock Text="{Binding CpuFormatted}" Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="{Binding CpuPercent, Converter={StaticResource HighCpuWeightConverter}}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Memory" Width="105" SortMemberPath="WorkingSetBytes">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding WorkingSetBytes, Converter={StaticResource MemoryHeatmapBrushConverter}}"
                                                    CornerRadius="4" Margin="1,1" Padding="8,2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock Text="{Binding MemoryFormatted}" Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="{Binding WorkingSetBytes, Converter={StaticResource HighMemoryWeightConverter}}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="70" SortMemberPath="ThreadCount"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding PriorityFormatted}" Width="90" SortMemberPath="Priority"/>
                                <DataGridTemplateColumn Header="Path" Width="*" SortMemberPath="ExePath">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="6,0,10,0">
                                                <!-- Real ExePath for applications on disk -->
                                                <TextBlock Text="{Binding ExePath}" Foreground="{DynamicResource SubTextBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExePath}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Enriched Descriptive Subtitle for Special Kernel / System Processes with empty path -->
                                                <TextBlock Text="{Binding Name, Converter={StaticResource ProcessDescriptionConverter}}"
                                                           Foreground="{DynamicResource AccentBrush}" Opacity="0.85" FontStyle="Italic" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExePath}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyStateText" Style="{StaticResource EmptyStateText}" Text="No processes found" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40"/>

                        <!-- Modern CyberGems Pulse & Spinner Initial Loader Overlay -->
                        <Grid x:Name="LoaderOverlay" Background="{DynamicResource CardBrush}" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Rotating CyberGem -->
                                <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource CardSecondaryBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="LoaderRotate" Angle="0"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="LoaderRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:1.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <TextBlock Text="◈" Foreground="{DynamicResource AccentBrush}" FontSize="24" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title & Status Subtitle -->
                                <TextBlock x:Name="LoaderTitle" Text="Recopilando procesos..." FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,14,0,3"/>
                                <TextBlock x:Name="LoaderSub" Text="Inicializando Motor NT • Calculando deltas de CPU" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center"/>

                                <!-- Glowing Progress Track -->
                                <Border Width="160" Height="3" CornerRadius="1.5" Background="{DynamicResource BorderBrush}" Margin="0,14,0,0" ClipToBounds="True">
                                    <Border Width="50" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="LoaderBarTrans" X="-50"/>
                                        </Border.RenderTransform>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="LoaderBarTrans"
                                                                         Storyboard.TargetProperty="X"
                                                                         From="-50" To="160" Duration="0:0:1.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock x:Name="FooterText" Text="Ready" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Group by application toggle -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock x:Name="GroupToggleLabel" Text="Group by application" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="GroupToggleLabel_Click"/>
                            <CheckBox x:Name="GroupToggleCheck" Style="{StaticResource CyberSnapToggleStyle}" VerticalAlignment="Center" Checked="GroupToggle_Checked" Unchecked="GroupToggle_Checked"/>
                        </StackPanel>

                        <!-- Text Size Slider -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="🗛" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="FontSizeSlider" Minimum="11" Maximum="17" Value="13" Width="70" VerticalAlignment="Center"
                                    SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Focusable="False" IsTabStop="False"
                                    ValueChanged="FontSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="FontSizeLabel" Text="13px" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- Always on top toggle -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TopmostLabel" Text="Always on top" FontSize="11" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="TopmostLabel_Click"/>
                            <CheckBox x:Name="TopmostCheck" Style="{StaticResource CyberSnapToggleStyle}" VerticalAlignment="Center" Checked="Topmost_Checked" Unchecked="Topmost_Checked"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
