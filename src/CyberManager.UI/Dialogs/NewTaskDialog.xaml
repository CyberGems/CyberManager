<Window x:Class="CyberManager.UI.Dialogs.NewTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="TaskButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.75"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TaskIconButton" TargetType="Button" BasedOn="{StaticResource TaskButton}">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,2,5,2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource SelectionBgBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AdminCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="17" Height="17" Margin="0,0,9,0" CornerRadius="4" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <Path x:Name="Check" Data="M 2 6 L 5 9 L 11 2" Stroke="{DynamicResource AccentFgBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" Margin="2" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="OuterBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="WindowScale"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect x:Name="WindowGlow" ShadowDepth="0" BlurRadius="16" Opacity="0"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="20,14,14,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Path Data="M 12 4 V 20 M 4 12 H 20" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="Heading" Grid.Column="1" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="HeaderClose" Grid.Column="2" Style="{StaticResource TaskIconButton}" Click="Cancel_Click">
                        <Path Data="M 3 3 L 13 13 M 13 3 L 3 13" Width="11" Height="11" Stretch="Uniform" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.5"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,18,22,20">
                    <TextBlock x:Name="Description" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" FontSize="13" Margin="0,0,0,18"/>
                    <Label x:Name="CommandLabel" Target="{Binding ElementName=CommandBox}" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" Padding="0" Margin="0,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="CommandFrame" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="11,0">
                            <Grid>
                                <TextBox x:Name="CommandBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                         FontFamily="Consolas, Segoe UI" FontSize="13" VerticalContentAlignment="Center" Height="36" MaxLength="32767"
                                         TextChanged="CommandBox_TextChanged" PreviewKeyDown="CommandBox_PreviewKeyDown"/>
                                <TextBlock x:Name="Placeholder" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource TaskButton}" Margin="10,0,0,0" Click="Browse_Click"/>
                    </Grid>
                    <TextBlock x:Name="CommandHint" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="0,7,0,18"/>
                    <CheckBox x:Name="AdminCheck" Style="{StaticResource AdminCheckStyle}">
                        <TextBlock x:Name="AdminLabel" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock x:Name="AdminHint" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="26,5,0,0" TextWrapping="Wrap"/>

                    <Border x:Name="ErrorPanel" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextBrush}" AutomationProperties.LiveSetting="Polite"/>
                    </Border>

                    <Grid Margin="0,22,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HistoryHeading" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ClearHistoryButton" Grid.Column="1" Style="{StaticResource TaskButton}" Height="28" FontSize="11.5" Padding="8,0" Click="ClearHistory_Click"/>
                    </Grid>
                    <TextBlock x:Name="HistoryHint" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" FontSize="11.5" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                        <Grid>
                            <TextBlock x:Name="HistoryEmpty" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="10,13" TextWrapping="Wrap"/>
                            <ListBox x:Name="HistoryList" MaxHeight="136" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="History_SelectionChanged">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas, Segoe UI" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" ToolTipOpening="HistoryCommand_ToolTipOpening"/>
                                        <Button Grid.Column="1" Style="{StaticResource TaskIconButton}" Margin="8,0,0,0" Click="RemoveHistory_Click"
                                                ToolTip="{DynamicResource RemoveHistoryLabel}" AutomationProperties.Name="{DynamicResource RemoveHistoryLabel}">
                                            <Path Data="M 3 3 L 11 11 M 11 3 L 3 11" Width="9" Height="9" Stretch="Uniform" Stroke="{DynamicResource SubTextBrush}" StrokeThickness="1.4"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource TaskButton}" MinWidth="110" IsCancel="True" Click="Cancel_Click" Margin="0,0,10,0" AutomationProperties.AcceleratorKey="Esc">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="CancelLabel" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource DialogKeyHintStyle}" Margin="10,0,0,0"><TextBlock Text="Esc" FontSize="10" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunButton" Style="{StaticResource TaskButton}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentFgBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            MinWidth="110" IsDefault="True" IsEnabled="False" Click="Run_Click" AutomationProperties.AcceleratorKey="Enter">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="RunLabel" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource DialogPrimaryKeyHintStyle}" Margin="10,0,0,0">
                                <Path Data="{StaticResource DialogEnterKeyGeometry}" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
