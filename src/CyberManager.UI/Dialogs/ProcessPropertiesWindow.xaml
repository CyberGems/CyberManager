<Window x:Class="CyberManager.UI.Dialogs.ProcessPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process properties"
        Width="560"
        Height="600"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <Window.Resources>
        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModalPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,16,8"/>
        </Style>

        <Style x:Key="PropertyValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Border Margin="6"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="20,14,14,12"
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="42"
                        Height="42"
                        CornerRadius="11"
                        Background="{DynamicResource CardSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,12,0">
                    <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 12,10 V 16 M 12,6 H 12.01"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="21"
                          Height="21"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="Transparent"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Process properties"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="FriendlyNameText"
                               Text=""
                               FontSize="11.5"
                               Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <TextBlock Text="✕" FontSize="11"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,0,20,8">
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="IdentitySectionText"
                                       Text="Identity"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FriendlyNameLabel" Grid.Row="0" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="FriendlyNameValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="ImageNameLabel" Grid.Row="1" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="ImageNameValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="PidLabel" Grid.Row="2" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="PidValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="PathLabel" Grid.Row="3" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="PathValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="FileSectionText"
                                       Text="File information"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CompanyLabel" Grid.Row="0" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="CompanyValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="ProductLabel" Grid.Row="1" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="ProductValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="VersionLabel" Grid.Row="2" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="VersionValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="OriginalFilenameLabel" Grid.Row="3" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="OriginalFilenameValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock x:Name="RuntimeSectionText"
                                       Text="Runtime"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="UserLabel" Grid.Row="0" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="UserValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="StatusLabel" Grid.Row="1" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="StatusValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="StartTimeLabel" Grid.Row="2" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="StartTimeValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="CpuLabel" Grid.Row="3" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="CpuValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="MemoryLabel" Grid.Row="4" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="MemoryValue" Grid.Row="4" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="ThreadsLabel" Grid.Row="5" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="ThreadsValue" Grid.Row="5" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="PriorityLabel" Grid.Row="6" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="PriorityValue" Grid.Row="6" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="ParentProcessLabel" Grid.Row="7" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="ParentProcessValue" Grid.Row="7" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="WindowTitleLabel" Grid.Row="8" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="WindowTitleValue" Grid.Row="8" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                                <TextBlock x:Name="InstancesLabel" Grid.Row="9" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBlock x:Name="InstancesValue" Grid.Row="9" Grid.Column="1" Style="{StaticResource PropertyValueStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource CardSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Button x:Name="CloseFooterButton"
                        Width="100"
                        Height="32"
                        HorizontalAlignment="Right"
                        Padding="14,0"
                        Style="{StaticResource ModalPrimaryButtonStyle}"
                        Click="CloseButton_Click"
                        IsDefault="True"
                        IsCancel="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CloseFooterText"
                                   Text="Close"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="↵"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
