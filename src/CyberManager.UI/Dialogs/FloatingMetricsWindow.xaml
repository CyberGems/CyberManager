<Window x:Class="CyberManager.UI.Dialogs.FloatingMetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberManager.UI.Controls"
        Title="CyberManager"
        Width="330"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetIconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="WidgetMenu" Style="{StaticResource ModernContextMenu}">
            <MenuItem x:Name="WidgetPinItem" Header="Always on top" IsCheckable="True" Style="{StaticResource ModernMenuItem}" Click="WidgetPinItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 9 3 H 15 L 14 9 L 18 12 V 14 H 6 V 12 L 10 9 Z M 12 14 V 21"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem x:Name="WidgetShowItem" Header="Show CyberManager" InputGestureText="Alt+Shift+M" Style="{StaticResource ModernMenuItem}" Click="WidgetShowItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 2 4 H 22 V 18 H 2 Z M 2 8 H 22"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator Style="{StaticResource ModernMenuSeparator}"/>

            <MenuItem x:Name="WidgetSysInfoItem" Header="System Information..." InputGestureText="Ctrl+I" Style="{StaticResource ModernMenuItem}" Click="WidgetSysInfoItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 2 12 L 6 12 L 9 5 L 14 19 L 17 12 L 22 12"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator Style="{StaticResource ModernMenuSeparator}"/>

            <MenuItem x:Name="WidgetSettingsItem" Header="Settings..." Style="{StaticResource ModernMenuItem}" Click="WidgetSettingsItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 12 15 C 10.3 15 9 13.7 9 12 C 9 10.3 10.3 9 12 9 C 13.7 9 15 10.3 15 12 C 15 13.7 13.7 15 12 15 Z M 19.4 13 C 19.5 12.7 19.5 12.3 19.5 12 C 19.5 11.7 19.5 11.3 19.4 11 L 21.5 9.4 C 21.7 9.2 21.8 8.9 21.6 8.7 L 19.6 5.2 C 19.5 5 19.2 4.9 19 5 L 16.5 6 C 16 5.6 15.4 5.3 14.8 5.1 L 14.4 2.4 C 14.4 2.2 14.2 2 13.9 2 L 10.1 2 C 9.8 2 9.6 2.2 9.6 2.4 L 9.2 5.1 C 8.6 5.3 8 5.6 7.5 6 L 5 5 C 4.8 4.9 4.5 5 4.4 5.2 L 2.4 8.7 C 2.2 8.9 2.3 9.2 2.5 9.4 L 4.6 11 C 4.5 11.3 4.5 11.7 4.5 12 C 4.5 12.3 4.5 12.7 4.6 13 L 2.5 14.6 C 2.3 14.8 2.2 15.1 2.4 15.3 L 4.4 18.8 C 4.5 19 4.8 19.1 5 19 L 7.5 18 C 8 18.4 8.6 18.7 9.2 18.9 L 9.6 21.6 C 9.6 21.8 9.8 22 10.1 22 L 13.9 22 C 14.2 22 14.4 21.8 14.4 21.6 L 14.8 18.9 C 15.4 18.7 16 18.4 16.5 18 L 19 19 C 19.2 19.1 19.5 19 19.6 18.8 L 21.6 15.3 C 21.8 15.1 21.7 14.8 21.5 14.6 L 19.4 13 Z"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem x:Name="WidgetAboutItem" Header="About CyberManager..." Style="{StaticResource ModernMenuItem}" Click="WidgetAboutItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 12 22 A 10 10 0 1 0 12 2 A 10 10 0 0 0 12 22 M 12 16 V 12 M 12 8 H 12.01"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator Style="{StaticResource ModernMenuSeparator}"/>

            <MenuItem x:Name="WidgetExitItem" Header="Exit" Style="{StaticResource ModernMenuItem}" Click="WidgetExitItem_Click">
                <MenuItem.Icon>
                    <Path Data="M 18.36 6.64 A 9 9 0 1 1 5.63 6.64 M 12 2 V 12"
                          Stroke="#F87171" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="Transparent"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid Margin="12,9,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="CyberManager"
                           FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource WidgetIconToggle}"
                                  Click="PinButton_Click">
                        <Path x:Name="PinIcon"
                              Data="M 9 3 H 15 L 14 9 L 18 12 V 14 H 6 V 12 L 10 9 Z M 12 14 V 21"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WidgetIconButton}"
                            Margin="4,0,0,0"
                            Click="CloseButton_Click">
                        <Path Data="M 6 6 L 18 18 M 18 6 L 6 18"
                              Stroke="{DynamicResource SubTextBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="11" Height="11" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="CpuRow" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="76" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="CpuLabel"
                               Text="CPU"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="CpuValueText"
                               Text="0.0%"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#10B981"/>
                </StackPanel>
                <controls:SparklineControl x:Name="CpuSparkline"
                                           Grid.Column="1"
                                           Height="34"
                                           StrokeBrush="#10B981"
                                           FillBrush="#2010B981"
                                           SecondaryStrokeBrush="#EF4444"
                                           SecondaryFillBrush="#40EF4444"/>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>

            <Grid x:Name="RamRow" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="76" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="RamLabel"
                               Text="RAM"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="RamValueText"
                               Text="0.0%"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource RamBrush}"/>
                </StackPanel>
                <controls:SparklineControl x:Name="RamSparkline"
                                           Grid.Column="1"
                                           Height="34"
                                           StrokeBrush="{DynamicResource RamBrush}"
                                           FillBrush="{DynamicResource RamFillBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
