<Window x:Class="CyberManager.UI.Dialogs.FloatingMetricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberManager.UI.Controls"
        Title="CyberManager"
        Width="330"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        LocationChanged="Window_LocationChanged">

    <Window.Resources>
        <Style x:Key="WidgetIconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WidgetIconToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid Margin="12,9,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="CyberManager"
                           FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource WidgetIconToggle}"
                                  Click="PinButton_Click">
                        <Path x:Name="PinIcon"
                              Data="M 9 3 H 15 L 14 9 L 18 12 V 14 H 6 V 12 L 10 9 Z M 12 14 V 21"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Width="13" Height="13" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WidgetIconButton}"
                            Margin="4,0,0,0"
                            Click="CloseButton_Click">
                        <Path Data="M 6 6 L 18 18 M 18 6 L 6 18"
                              Stroke="{DynamicResource SubTextBrush}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="11" Height="11" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="CpuRow" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="76" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="CpuLabel"
                               Text="CPU"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="CpuValueText"
                               Text="0.0%"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#10B981"/>
                </StackPanel>
                <controls:SparklineControl x:Name="CpuSparkline"
                                           Grid.Column="1"
                                           Height="34"
                                           StrokeBrush="#10B981"
                                           FillBrush="#2010B981"
                                           SecondaryStrokeBrush="#EF4444"
                                           SecondaryFillBrush="#40EF4444"/>
            </Grid>

            <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10"/>

            <Grid x:Name="RamRow" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="76" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="RamLabel"
                               Text="RAM"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock x:Name="RamValueText"
                               Text="0.0%"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource RamBrush}"/>
                </StackPanel>
                <controls:SparklineControl x:Name="RamSparkline"
                                           Grid.Column="1"
                                           Height="34"
                                           StrokeBrush="{DynamicResource RamBrush}"
                                           FillBrush="{DynamicResource RamFillBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
