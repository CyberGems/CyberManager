<Window x:Class="CyberManager.UI.Dialogs.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberManager.UI.Controls"
        Title="System Information ᐧ CyberManager"
        Icon="pack://application:,,,/Assets/CyberManager.ico"
        Height="650" Width="860"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Title Button -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title Close Button -->
        <Style x:Key="TitleCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab RadioButton Style -->
        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="6" CornerRadius="12">
        <Border x:Name="OuterBorder" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}" ClipToBounds="True">
            <Grid Margin="20,14,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Tab Bar -->
                    <RowDefinition Height="*"/>    <!-- Tab Content -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Bar -->
                </Grid.RowDefinitions>

                <!-- Row 0: Title Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/CyberManager.png" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="System Information" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="NT ENGINE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="CpuModelSubtitle" Text="Real-Time System Monitor" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBtn}" Click="Minimize_Click" ToolTip="Minimize"><TextBlock Text="—" FontSize="11"/></Button>
                        <Button Style="{StaticResource TitleBtn}" Click="Maximize_Click" ToolTip="Maximize"><TextBlock Text="☐" FontSize="10"/></Button>
                        <Button Style="{StaticResource TitleCloseBtn}" Click="Close_Click" ToolTip="Close"><TextBlock Text="✕" FontSize="11"/></Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Tab Navigation Bar -->
                <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6,4" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab icons follow the button's own Foreground so they share the idle,
                             hover and checked colors of their labels. -->
                        <RadioButton x:Name="TabSummary" Style="{StaticResource TabNavButton}" IsChecked="True" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 5 5 H 11 V 11 H 5 Z M 13 5 H 19 V 11 H 13 Z M 5 13 H 11 V 19 H 5 Z M 13 13 H 19 V 19 H 13 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TabSummaryLabel" Text="Summary" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabCpu" Style="{StaticResource TabNavButton}" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 6 6 H 18 V 18 H 6 Z M 9 3 V 6 M 15 3 V 6 M 9 18 V 21 M 15 18 V 21 M 3 9 H 6 M 18 9 H 21 M 3 15 H 6 M 18 15 H 21"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TabCpuLabel" Text="CPU" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabMemory" Style="{StaticResource TabNavButton}" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 4 7 H 20 V 12 H 4 Z M 4 15 H 20 V 20 H 4 Z M 8 12 V 15 M 16 12 V 15"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TabMemoryLabel" Text="Memory" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabIo" Style="{StaticResource TabNavButton}" Checked="Tab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 2 12 H 6.5 L 9.5 5.5 L 13.5 18.5 L 16.5 9 L 18 12 H 22"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TabIoLabel" Text="I/O" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Row 2: Dynamic Tab Content Container -->
                <Grid Grid.Row="2">
                    
                    <!-- TAB 1: SUMMARY (Dual Graphs + 4 Stat Cards) -->
                    <Grid x:Name="ViewSummary" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*"/> <!-- Dual Graphs -->
                            <RowDefinition Height="Auto"/> <!-- Stat Cards -->
                        </Grid.RowDefinitions>

                        <!-- Dual Graphs Area -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Big CPU Graph -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                        <Path Data="M 4 5 V 19 H 20 M 4 15 L 9.5 10 L 13 12.5 L 20 5.5"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CpuHistoryTitle" Text="CPU History" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CpuLegend" Text="(User / Kernel)" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <controls:LargeHistoryGraphControl x:Name="SummaryCpuGraph" Grid.Row="1" Title="CPU" UnitSuffix="%" PrimaryColor="#10B981" SecondaryColor="#EF4444"/>
                                </Grid>
                            </Border>

                            <!-- Right: Big Memory Graph -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                        <Path Data="M 4 7 H 20 V 12 H 4 Z M 4 15 H 20 V 20 H 4 Z M 8 12 V 15 M 16 12 V 15"
                                              Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MemHistoryTitle" Text="Memory History" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MemLegend" Text="(In Use / Commit)" FontSize="10" Foreground="{DynamicResource SubTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <controls:LargeHistoryGraphControl x:Name="SummaryMemGraph" Grid.Row="1" Title="RAM" UnitSuffix="%" PrimaryColor="{DynamicResource RamColor}" SecondaryColor="#A855F7"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bottom 4 Stat Cards -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Totals -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TotalsCardTitle" Text="Totals" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="HandlesLbl" Text="Handles" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="HandlesVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="ThreadsLbl" Text="Threads" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="ThreadsVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="ProcessesLbl" Text="Processes" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="ProcessesVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: CPU Breakdown -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="CpuCardTitle" Text="CPU" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="CpuTotalLbl" Text="Total" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="CpuTotalVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="CpuKernelLbl" Text="Kernel" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="CpuKernelVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="CpuUserLbl" Text="User" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="CpuUserVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Memory Breakdown -->
                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="MemCardTitle" Text="Memory (GB)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="MemInUseLbl" Text="In Use" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="MemInUseVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RamBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="MemAvailLbl" Text="Available" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="MemAvailVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="MemTotalLbl" Text="Total" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="MemTotalVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Topology -->
                            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="TopologyCardTitle" Text="Topology" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="CoresLbl" Text="Cores" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="CoresVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="SocketsLbl" Text="Sockets" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="SocketsVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <TextBlock x:Name="LogProcLbl" Text="Logical" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        <TextBlock x:Name="LogProcVal" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 2: CPU FULL VIEW -->
                    <Grid x:Name="ViewCpu" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource StatCard}" Margin="0,0,0,12" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <Path Data="M 4 5 V 19 H 20 M 4 15 L 9.5 10 L 13 12.5 L 20 5.5"
                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FullCpuHistoryTitle" Text="CPU Activity History (User &amp; Kernel Time)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <controls:LargeHistoryGraphControl x:Name="FullCpuGraph" Grid.Row="1" Title="CPU" UnitSuffix="%" PrimaryColor="#10B981" SecondaryColor="#EF4444"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="FullCpuMetricsTitle" Text="CPU Metrics" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3"><TextBlock Text="CPU Total" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCpuTotal" Text="—" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Kernel Mode CPU" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCpuKernel" Text="—" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="User Mode CPU" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCpuUser" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="ProcessorTopologyTitle" Text="Processor Topology" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3"><TextBlock Text="Processor Model" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCpuModel" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Physical Cores" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCpuCores" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Logical Processors" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCpuLogical" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 3: MEMORY FULL VIEW -->
                    <Grid x:Name="ViewMemory" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource StatCard}" Margin="0,0,0,12" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <Path Data="M 4 7 H 20 V 12 H 4 Z M 4 15 H 20 V 20 H 4 Z M 8 12 V 15 M 16 12 V 15"
                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FullMemHistoryTitle" Text="Physical Memory &amp; Commit History" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <controls:LargeHistoryGraphControl x:Name="FullMemGraph" Grid.Row="1" Title="RAM" UnitSuffix="%" PrimaryColor="{DynamicResource RamColor}" SecondaryColor="#A855F7"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="PhysicalMemoryTitle" Text="Physical Memory (GB)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3"><TextBlock Text="Total Physical" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullMemTotal" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="In Use" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullMemInUse" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource RamBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="Available" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullMemAvail" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="CommitChargeTitle" Text="Commit Charge (GB)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3"><TextBlock x:Name="CommitTotalLbl" Text="Committed Total" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCommitTotal" Text="—" FontWeight="SemiBold" Foreground="#A855F7" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock x:Name="CommitLimitLbl" Text="Commit Limit" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCommitLimit" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock x:Name="CommitPeakLbl" Text="Commit Peak" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullCommitPeak" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock x:Name="KernelPoolTitle" Text="Kernel Pool (MB)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3"><TextBlock x:Name="PagedPoolLbl" Text="Paged Pool" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullPagedPool" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock x:Name="NonPagedPoolLbl" Text="Non-Paged Pool" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullNonPagedPool" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,3"><TextBlock x:Name="FullHandlesLbl" Text="Total Handles" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="FullHandles" Text="—" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 4: I/O VIEW -->
                    <Grid x:Name="ViewIo" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Section header -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="IoTitle" Text="System Activity Overview" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>

                        <Grid Grid.Row="1" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: System overview, headline process count -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="18,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="IoSystemTitle" Text="System" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,14">
                                        <TextBlock x:Name="IoProcessesVal" Text="—" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="IoProcessesLbl" Text="Total Active System Processes" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                        <Grid Margin="0,6">
                                            <TextBlock x:Name="IoThreadsLbl" Text="Threads" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="IoThreadsVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,6">
                                            <TextBlock x:Name="IoHandlesLbl" Text="Handles" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="IoHandlesVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,6">
                                            <TextBlock x:Name="IoUptimeLbl" Text="System Up Time" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                                            <TextBlock x:Name="IoUptimeVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2: Kernel memory -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="18,16">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock x:Name="IoKernelTitle" Text="Kernel Memory (MB)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoPagedLbl" Text="Paged Pool" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoPagedVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoNonPagedLbl" Text="Non-Paged Pool" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoNonPagedVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoCacheLbl" Text="File Cache" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoCacheVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 3: Commit charge -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Padding="18,16">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock x:Name="IoCommitTitle" Text="Commit Charge (GB)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoCommitTotalLbl" Text="Committed" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoCommitTotalVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoCommitLimitLbl" Text="Limit" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoCommitLimitVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoCommitPeakLbl" Text="Peak" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoCommitPeakVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Physical memory at a glance -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Padding="18,16">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock x:Name="IoPhysicalTitle" Text="Physical Memory" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoInUseLbl" Text="In Use" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoInUseVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource RamBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoAvailLbl" Text="Available" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoAvailVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                    <Grid Margin="0,7"><TextBlock x:Name="IoLoadLbl" Text="Memory Load" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/><TextBlock x:Name="IoLoadVal" Text="—" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Row 3: Bottom Bar -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TelemetryFooter" Text="⚡ Real-time telemetry via NT Kernel Engine • 60s sample window" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                    </StackPanel>
                    <Button Content="OK" MinWidth="80" HorizontalAlignment="Right" Style="{StaticResource ModernButton}" Click="Close_Click" IsDefault="True"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
