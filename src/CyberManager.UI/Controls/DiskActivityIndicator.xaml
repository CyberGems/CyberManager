<UserControl x:Class="CyberManager.UI.Controls.DiskActivityIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="22" MinHeight="22">
    <Button x:Name="ActivityButton" Background="Transparent" BorderThickness="0" Padding="2" Cursor="Hand"
            ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="20000">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HeaderBgBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <Grid Width="14" Height="14" IsHitTestVisible="False">
            <Ellipse x:Name="Led" Stroke="{DynamicResource BorderLightBrush}" StrokeThickness="0.7">
                <Ellipse.Effect><DropShadowEffect x:Name="Glow" BlurRadius="7" ShadowDepth="0" Opacity="0"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="5" Height="3" Fill="White" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,2,0,0"/>
        </Grid>
    </Button>
</UserControl>
