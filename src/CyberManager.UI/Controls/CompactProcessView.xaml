<UserControl x:Class="CyberManager.UI.Controls.CompactProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberManager.UI.Services"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
        <conv:CpuHeatmapBrushConverter x:Key="CpuHeatmapBrushConverter"/>
        <conv:MemoryHeatmapBrushConverter x:Key="MemoryHeatmapBrushConverter"/>
        <conv:HighCpuWeightConverter x:Key="HighCpuWeightConverter"/>
        <conv:HighMemoryWeightConverter x:Key="HighMemoryWeightConverter"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="AccentLine"
                                        Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <Path x:Name="SortArrow"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource AccentBrush}"
                                          Data="M 0 0 L 4 5 L 8 0 Z"
                                          Width="8"
                                          Height="5"
                                          Stretch="Uniform"
                                          Visibility="Collapsed"/>
                                </StackPanel>
                                <Thumb x:Name="PART_LeftHeaderGripper"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch"
                                       Width="6"
                                       Background="Transparent"
                                       Cursor="SizeWE"/>
                                <Thumb x:Name="PART_RightHeaderGripper"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Width="6"
                                       Background="Transparent"
                                       Cursor="SizeWE"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 5 L 4 0 L 8 5 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 5 L 8 0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource GridAltBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsContextTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DimWhenSuspended}" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactGridValueTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CompactSearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SearchBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0"
            CornerRadius="6"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="CompactTitleBar" Grid.Row="0" Margin="2,0,2,6" Height="30" Background="Transparent" PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="BrandingPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsHitTestVisible="True">
                    <Image Source="pack://application:,,,/Assets/CyberManager.png"
                           Width="24"
                           Height="24"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="CyberManager"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="5,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="EngineBadgeText"
                                   Text="NT ENGINE"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="8.5"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="CompactMetricsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Border x:Name="CompactCpuMetricHost"
                            Background="{DynamicResource CardSecondaryBrush}"
                            CornerRadius="4"
                            Padding="5,2"
                            Margin="0,0,4,0"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompactCpuLabel"
                                       Text="CPU"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,0,4,0"/>
                            <TextBlock x:Name="CompactCpuText"
                                       Text="0.0%"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CompactRamMetricHost"
                            Background="{DynamicResource CardSecondaryBrush}"
                            CornerRadius="4"
                            Padding="5,2"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompactRamLabel"
                                       Text="RAM"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,0,4,0"/>
                            <TextBlock x:Name="CompactRamText"
                                       Text="0.0 GB"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="PinButtonHost"
                            Width="32"
                            Height="30"
                            CornerRadius="5"
                            BorderThickness="0"
                            ClipToBounds="False">
                        <Button x:Name="PinButton"
                            Width="28"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="📌"
                            FontSize="12"
                            Padding="0"
                            Style="{DynamicResource TitleBtn}"
                            Click="PinButton_Click"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave"
                            ToolTip="Always on top"
                            AutomationProperties.Name="Always on top"/>
                    </Border>
                    <Border x:Name="ModeButtonHost"
                            Width="32"
                            Height="30"
                            Margin="2,0,0,0"
                            CornerRadius="5"
                            Background="{DynamicResource AccentGlowBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <Button x:Name="ModeButton"
                            Width="28"
                            Height="26"
                            Style="{DynamicResource ModeIconButton}"
                            Padding="0"
                            Click="MoreDetailsButton_Click"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave"
                            ToolTip="Más detalles"
                            AutomationProperties.Name="Más detalles">
                            <Path Data="M 3,8 L 3,3 L 8,3 M 3,3 L 8,8 M 13,16 L 16,16 L 16,11 M 16,16 L 11,11"
                                  Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                    </Border>
                    <Button x:Name="SettingsButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Content="⚙"
                        FontSize="13"
                        Padding="0"
                        Style="{DynamicResource TitleBtn}"
                        Click="SettingsButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings"/>
                    <Button x:Name="MinimizeButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Padding="0"
                        Style="{DynamicResource TitleBtn}"
                        Click="MinimizeButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="Minimize"
                        AutomationProperties.Name="Minimize">
                        <Path Data="M 3,12 H 13"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="CloseButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Content="✕"
                        Style="{DynamicResource TitleCloseBtn}"
                        Click="CloseButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="Close"
                        AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="CompactActionBar" Grid.Row="1" Margin="2,0,2,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Height="26"
                         MinWidth="60"
                         Margin="0,0,6,0"
                         Padding="7,0"
                         Style="{StaticResource CompactSearchBoxStyle}"
                         FontSize="11"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Search processes"
                         ToolTip="Search process, PID or path..."
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>

                <Button x:Name="EndTaskButton"
                        Grid.Column="1"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Style="{DynamicResource DangerModernButton}"
                        Click="EndTaskButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="End task"
                        AutomationProperties.Name="End task">
                    <Path Data="M 3,3 H 13 V 13 H 3 Z"
                          Width="11"
                          Height="11"
                          Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
            <DataGrid x:Name="CompactGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                      SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                      FontSize="{Binding RowFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource CardBrush}"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AutomationProperties.Name="Compact process list">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Process" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="4,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                        <Image x:Name="ProcessIcon"
                                               Source="{Binding ExePath, Converter={StaticResource PathToIconConverter}}"
                                               Width="16"
                                               Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="◈"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=ProcessIcon, Path=Visibility}" Value="Collapsed">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="62" SortMemberPath="Pid"
                                        ElementStyle="{StaticResource CompactGridValueTextStyle}"/>
                    <DataGridTemplateColumn Header="CPU" Width="68" SortMemberPath="CpuPercent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CpuPercent, Converter={StaticResource CpuHeatmapBrushConverter}}"
                                        CornerRadius="3"
                                        Margin="1,1"
                                        Padding="5,1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding CpuFormatted}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="{Binding CpuPercent, Converter={StaticResource HighCpuWeightConverter}}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Memory" Width="82" SortMemberPath="WorkingSetBytes">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding WorkingSetBytes, Converter={StaticResource MemoryHeatmapBrushConverter}}"
                                        CornerRadius="3"
                                        Margin="1,1"
                                        Padding="5,1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding MemoryFormatted}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="{Binding WorkingSetBytes, Converter={StaticResource HighMemoryWeightConverter}}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyStateText"
                       Text="No processes found"
                       Foreground="{DynamicResource SubTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="3" Margin="2,6,2,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{DynamicResource SubTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ContextHintText"
                           Text="Right-click a process for actions"
                           Foreground="{DynamicResource SubTextBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
