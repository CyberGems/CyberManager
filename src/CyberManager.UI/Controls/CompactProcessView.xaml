<UserControl x:Class="CyberManager.UI.Controls.CompactProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberManager.UI.Services"
             xmlns:controls="clr-namespace:CyberManager.UI.Controls"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>
        <conv:SystemProcessIconConverter x:Key="SystemProcessIconConverter"/>
        <conv:CpuHeatmapBrushConverter x:Key="CpuHeatmapBrushConverter"/>
        <conv:MemoryHeatmapBrushConverter x:Key="MemoryHeatmapBrushConverter"/>
        <conv:HighCpuWeightConverter x:Key="HighCpuWeightConverter"/>
        <conv:HighMemoryWeightConverter x:Key="HighMemoryWeightConverter"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="Loaded" Handler="ColumnHeader_Loaded"/>
            <EventSetter Event="ContextMenuOpening" Handler="ColumnHeader_ContextMenuOpening"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource SelectionBgBrush}"
                                        Opacity="0"
                                        CornerRadius="0"/>
                                <Border x:Name="AccentLine"
                                        Height="2"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                    <Path x:Name="SortArrow"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="{DynamicResource AccentBrush}"
                                          Data="M 0 0 L 4 5 L 8 0 Z"
                                          Width="8"
                                          Height="5"
                                          Stretch="Uniform"
                                          Visibility="Collapsed"/>
                                </StackPanel>
                                <Thumb x:Name="PART_LeftHeaderGripper"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Stretch"
                                       Width="6"
                                       Background="Transparent"
                                       Cursor="SizeWE"
                                       OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                                <Thumb x:Name="PART_RightHeaderGripper"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Width="6"
                                       Background="Transparent"
                                       Cursor="SizeWE"
                                       OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="AccentLine" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 5 L 4 0 L 8 5 Z"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 5 L 8 0 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Rows must be focusable: this grid uses SelectionUnit=FullRow with non-focusable
                 cells, so the row is the only element that can take keyboard focus. Without it
                 arrow-key navigation silently does nothing. -->
            <Setter Property="Focusable" Value="True"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource GridAltBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsContextTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DimWhenSuspended}" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactGridValueTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0"
            CornerRadius="6"
            Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="CompactTitleBar" Grid.Row="0" Margin="2,0,2,6" Height="30" Background="Transparent" PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown" PreviewMouseLeftButtonUp="TitleBar_MouseLeftButtonUp" PreviewMouseMove="TitleBar_MouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="BrandingPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsHitTestVisible="True"
                            Cursor="Hand">
                    <Image Source="pack://application:,,,/Assets/CyberManager.png"
                           Width="24"
                           Height="24"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="CyberManager"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="5,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="EngineBadgeText"
                                   Text="NT ENGINE"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="8.5"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="CompactMetricsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Border x:Name="CompactCpuMetricHost"
                            Background="{DynamicResource CardSecondaryBrush}"
                            CornerRadius="4"
                            Padding="5,2"
                            Margin="0,0,4,0"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompactCpuLabel"
                                       Text="CPU"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,0,4,0"/>
                            <TextBlock x:Name="CompactCpuText"
                                       Text="0.0%"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="CompactRamMetricHost"
                            Background="{DynamicResource CardSecondaryBrush}"
                            CornerRadius="4"
                            Padding="5,2"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompactRamLabel"
                                       Text="RAM"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Margin="0,0,4,0"/>
                            <TextBlock x:Name="CompactRamText"
                                       Text="0.0%"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="PinButtonHost"
                            Width="32"
                            Height="30"
                            CornerRadius="5"
                            BorderThickness="0"
                            ClipToBounds="False">
                        <Button x:Name="PinButton"
                            Width="28"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="📌"
                            FontSize="12"
                            Padding="0"
                            Style="{DynamicResource TitleBtn}"
                            Click="PinButton_Click"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave"
                            ToolTip="Always on top"
                            AutomationProperties.Name="Always on top"/>
                    </Border>
                    <Border x:Name="ModeButtonHost"
                            Width="32"
                            Height="30"
                            Margin="2,0,0,0"
                            CornerRadius="5"
                            Background="{DynamicResource AccentGlowBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <Button x:Name="ModeButton"
                            Width="28"
                            Height="26"
                            Style="{DynamicResource ModeIconButton}"
                            Padding="0"
                            Click="MoreDetailsButton_Click"
                            MouseEnter="InteractiveControl_MouseEnter"
                            MouseLeave="InteractiveControl_MouseLeave"
                            ToolTip="Más detalles"
                            AutomationProperties.Name="Más detalles">
                            <Path Data="M 3,8 L 3,3 L 8,3 M 3,3 L 8,8 M 13,16 L 16,16 L 16,11 M 16,16 L 11,11"
                                  Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                    </Border>
                    <Button x:Name="SettingsButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Content="⚙"
                        FontSize="13"
                        Padding="0"
                        Style="{DynamicResource TitleBtn}"
                        Click="SettingsButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings"/>
                    <Button x:Name="MoreButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Padding="0"
                        Style="{DynamicResource TitleBtn}"
                        Click="MoreButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="More options"
                        AutomationProperties.Name="More options">
                        <Path Data="M 5,10.5 a 1.5,1.5 0 1 0 0,3 a 1.5,1.5 0 1 0 0,-3 M 12,10.5 a 1.5,1.5 0 1 0 0,3 a 1.5,1.5 0 1 0 0,-3 M 19,10.5 a 1.5,1.5 0 1 0 0,3 a 1.5,1.5 0 1 0 0,-3"
                              Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MinimizeButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Padding="0"
                        Style="{DynamicResource TitleBtn}"
                        Click="MinimizeButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="Minimize"
                        AutomationProperties.Name="Minimize">
                        <Path Data="M 3,12 H 13"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="CloseButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Content="✕"
                        Style="{DynamicResource TitleCloseBtn}"
                        Click="CloseButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="Close"
                        AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="CompactActionBar" Grid.Row="1" Margin="2,0,2,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CompactSearchBar"
                        Grid.Column="0"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="0"
                        Style="{DynamicResource SearchBarStyle}">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Height="24"
                                 MinWidth="60"
                                 Padding="7,0,58,0"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="Search processes"
                                 ToolTip="Search process, PID or path..."
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <TextBlock x:Name="SearchHint"
                                   Text=""
                                   Foreground="{DynamicResource SubTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Margin="7,0,58,0"/>
                        <Button x:Name="SearchHistoryButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,26,0"
                                Width="24"
                                Height="24"
                                Style="{DynamicResource SearchHistoryButtonStyle}"
                                Click="SearchHistoryButton_Click"
                                ToolTip=""
                                AutomationProperties.Name="">
                            <Path Data="M 12,2 A 10,10 0 1 0 22,12 A 10,10 0 0 0 12,2 M 12,6 V 12 L 16,14"
                                  Stroke="{DynamicResource SubTextBrush}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="Transparent"/>
                        </Button>
                        <Button x:Name="ClearSearchButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="24"
                                Height="24"
                                Content="✕"
                                Style="{DynamicResource SearchClearButtonStyle}"
                                Click="ClearSearchButton_Click"
                                Visibility="Collapsed"
                                ToolTip="Clear"
                                AutomationProperties.Name="Clear search"/>
                    </Grid>
                </Border>

                <ToggleButton x:Name="HeavyFilterToggle"
                              Grid.Column="1"
                              Width="28"
                              Height="26"
                              Margin="0,0,6,0"
                              Style="{DynamicResource HeavyFilterToggleStyle}"
                              Checked="HeavyFilterToggle_Changed"
                              Unchecked="HeavyFilterToggle_Changed"
                              ToolTip=""
                              AutomationProperties.Name="">
                    <Path Data="M 4,4 H 20 L 14,11 V 19 L 10,17 V 11 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.3"
                          StrokeLineJoin="Round"
                          Width="13"
                          Height="13"
                          Stretch="Uniform"
                          Fill="Transparent"/>
                </ToggleButton>

                <Button x:Name="EndTaskButton"
                        Grid.Column="2"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Style="{DynamicResource ModernButton}"
                        Click="EndTaskButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="End task"
                        AutomationProperties.Name="End task">
                    <Path Data="M 3,3 H 13 V 13 H 3 Z"
                          Width="11"
                          Height="11"
                          Stretch="Uniform"
                          Fill="#E81123"/>
                </Button>

                <Button x:Name="RestartButton"
                        Grid.Column="4"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Style="{DynamicResource ModernButton}"
                        Click="RestartButton_Click"
                        MouseEnter="InteractiveControl_MouseEnter"
                        MouseLeave="InteractiveControl_MouseLeave"
                        ToolTip="Restart process"
                        AutomationProperties.Name="Restart process">
                    <Path Data="M 8,2 A 6,6 0 1 1 2.6,8.6 M 8,2 V 0 M 8,2 H 6"
                          Width="12"
                          Height="12"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          Fill="Transparent"/>
                </Button>

                <ToggleButton x:Name="PauseDetectionButton"
                              Grid.Column="3"
                              Width="28"
                              Height="26"
                              Margin="0,0,6,0"
                              Padding="0"
                              Style="{DynamicResource HeavyFilterToggleStyle}"
                              Click="PauseDetectionButton_Click"
                              MouseEnter="InteractiveControl_MouseEnter"
                              MouseLeave="InteractiveControl_MouseLeave"
                              ToolTip="Freeze"
                              AutomationProperties.Name="Freeze">
                    <Path x:Name="PauseDetectionIcon"
                          Data="M 5,3 H 9 V 21 H 5 Z M 15,3 H 19 V 21 H 15 Z"
                          Fill="{DynamicResource AccentBrush}"
                          Width="12" Height="12" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                <Border x:Name="SelectionBadge"
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        Padding="6,2"
                        CornerRadius="8"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SelectionCountText"
                                   AutomationProperties.AutomationId="SelectionCountText"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="ClearSelectionButton"
                                AutomationProperties.AutomationId="ClearSelectionBtn"
                                Width="14" Height="14"
                                Margin="4,0,0,0"
                                Padding="0"
                                Content="✕"
                                FontSize="8"
                                Style="{DynamicResource ModernButton}"
                                Click="ClearSelectionButton_Click"
                                ToolTip="Clear selection"
                                AutomationProperties.Name="Clear selection"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
            <DataGrid x:Name="CompactGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                      SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                      FontSize="{Binding RowFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource CardBrush}"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      AutomationProperties.Name="Compact process list">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Process" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="4,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                        <Image x:Name="ProcessIcon"
                                               Source="{Binding ExePath, Converter={StaticResource PathToIconConverter}}"
                                               Width="16"
                                               Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Path Data="{Binding Name, Converter={StaticResource SystemProcessIconConverter}}"
                                              Stroke="{DynamicResource SubTextBrush}"
                                              StrokeThickness="1.4"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="Transparent">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=ProcessIcon, Path=Visibility}" Value="Collapsed">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FriendlyName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0">
                                            <Border Background="{DynamicResource CardSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsGroupParent, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{Binding InstanceCount}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <Border Background="#2024A6B5"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding MainWindowTitle}"
                                                    Visibility="{Binding HasWindow, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="UI"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="62" SortMemberPath="Pid"
                                        ElementStyle="{StaticResource CompactGridValueTextStyle}"/>
                    <DataGridTemplateColumn Header="CPU" Width="68" SortMemberPath="CpuPercent">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CpuPercent, Converter={StaticResource CpuHeatmapBrushConverter}}"
                                        CornerRadius="3"
                                        Margin="1,1"
                                        Padding="8,1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding CpuFormatted}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="{Binding CpuPercent, Converter={StaticResource HighCpuWeightConverter}}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Memory" Width="82" SortMemberPath="WorkingSetBytes">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding WorkingSetBytes, Converter={StaticResource MemoryHeatmapBrushConverter}}"
                                        CornerRadius="3"
                                        Margin="1,1"
                                        Padding="8,1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding MemoryFormatted}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="{Binding WorkingSetBytes, Converter={StaticResource HighMemoryWeightConverter}}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyStateText"
                       Text="No processes found"
                       Foreground="{DynamicResource SubTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <!-- Compact list has its own loader instance: the full view's overlay lives in a
                 panel that is collapsed in this mode, so without this the compact window showed
                 "No processes found" while the first collection was still running. -->
            <controls:ProcessLoaderOverlay x:Name="LoaderOverlay" Visibility="Visible"/>
            </Grid>

            <Grid Grid.Row="3" Margin="2,6,2,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{DynamicResource SubTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ContextHintText"
                           Text="Right-click a process for actions"
                           Foreground="{DynamicResource SubTextBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
