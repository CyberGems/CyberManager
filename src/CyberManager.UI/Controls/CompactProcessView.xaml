<UserControl x:Class="CyberManager.UI.Controls.CompactProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CyberManager.UI.Services"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="PathToIconConverter"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource GridAltBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsContextTarget}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DimWhenSuspended}" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="CompactTitleBar" Grid.Row="0" Margin="2,0,2,6" Height="30" Background="Transparent" PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="BrandingPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsHitTestVisible="True">
                    <Image Source="pack://application:,,,/Assets/CyberManager.png"
                           Width="24"
                           Height="24"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="CyberManager"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource CardSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="5,1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="NT ENGINE"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="8.5"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="PinButtonHost"
                            Width="32"
                            Height="30"
                            CornerRadius="7"
                            BorderThickness="0"
                            ClipToBounds="False">
                        <Button x:Name="PinButton"
                            Width="28"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="📌"
                            FontSize="12"
                            Padding="0"
                            Style="{DynamicResource TitleBtn}"
                            Click="PinButton_Click"
                            ToolTip="Always on top"
                            AutomationProperties.Name="Always on top"/>
                    </Border>
                    <Border x:Name="ModeButtonHost"
                            Width="32"
                            Height="30"
                            Margin="2,0,0,0"
                            CornerRadius="7"
                            Background="{DynamicResource AccentGlowBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <Button x:Name="ModeButton"
                            Width="28"
                            Height="26"
                            Style="{DynamicResource ModeIconButton}"
                            Padding="0"
                            Click="MoreDetailsButton_Click"
                            ToolTip="Más detalles"
                            AutomationProperties.Name="Más detalles">
                            <Path Data="M 3,8 L 3,3 L 8,3 M 3,3 L 8,8 M 13,16 L 16,16 L 16,11 M 16,16 L 11,11"
                                  Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                    </Border>
                    <Button x:Name="SettingsButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Content="⚙"
                        FontSize="13"
                        Padding="0"
                        Style="{DynamicResource TitleBtn}"
                        Click="SettingsButton_Click"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings"/>
                    <Button x:Name="CloseButton"
                        Width="28"
                        Height="26"
                        Margin="2,0,0,0"
                        Content="✕"
                        Style="{DynamicResource TitleCloseBtn}"
                        Click="CloseButton_Click"
                        ToolTip="Close"
                        AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="CompactActionBar" Grid.Row="1" Margin="2,0,2,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Height="26"
                         MinWidth="60"
                         Margin="0,0,6,0"
                         Padding="7,0"
                         Background="{DynamicResource SearchBgBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         FontSize="11"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Search processes"
                         ToolTip="Search process, PID or path..."
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Width="28"
                        Height="26"
                        Margin="0,0,4,0"
                        Content="↻"
                        FontSize="14"
                        Padding="0"
                        Style="{DynamicResource ModernButton}"
                        Click="RefreshButton_Click"
                        ToolTip="Refresh"
                        AutomationProperties.Name="Refresh"/>

                <Button x:Name="EndTaskButton"
                        Grid.Column="2"
                        Width="28"
                        Height="26"
                        Padding="0"
                        Content="✕"
                        Style="{DynamicResource DangerModernButton}"
                        Click="EndTaskButton_Click"
                        ToolTip="End task"
                        AutomationProperties.Name="End task"/>
            </Grid>

            <Grid Grid.Row="2">
            <DataGrid x:Name="CompactGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                      SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                      FontSize="{Binding RowFontSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="{DynamicResource CardBrush}"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AutomationProperties.Name="Compact process list">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Process" Width="*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" Margin="4,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" HorizontalAlignment="Center">
                                        <Image x:Name="ProcessIcon"
                                               Source="{Binding ExePath, Converter={StaticResource PathToIconConverter}}"
                                               Width="16"
                                               Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="◈"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=ProcessIcon, Path=Visibility}" Value="Collapsed">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="62" SortMemberPath="Pid"/>
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuFormatted}" Width="68" SortMemberPath="CpuPercent"/>
                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryFormatted}" Width="82" SortMemberPath="WorkingSetBytes"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyStateText"
                       Text="No processes found"
                       Foreground="{DynamicResource SubTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="3" Margin="2,6,2,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{DynamicResource SubTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ContextHintText"
                           Text="Right-click a process for actions"
                           Foreground="{DynamicResource SubTextBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Opacity="0.8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
