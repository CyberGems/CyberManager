<UserControl x:Class="CyberManager.UI.Controls.MetricToolTipContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">
    <!--
        Body of the CPU and RAM tooltips, shared by the title-bar pills and the full window's metric
        cards so both read the same. The values are pushed in by SetContent on every sample instead
        of being rebuilt, which keeps the popup open and updating while the user reads it.
    -->
    <StackPanel MinWidth="190" MaxWidth="260">
        <TextBlock x:Name="TitleText"
                   FontSize="10.5"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SubTextBrush}"/>
        <TextBlock x:Name="ValueText"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,2,0,0"/>
        <TextBlock x:Name="DetailText"
                   FontSize="11.5"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SubTextBrush}"/>
        <TextBlock x:Name="HintText"
                   FontSize="10.5"
                   Margin="0,7,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   Foreground="{DynamicResource SubTextBrush}"/>
    </StackPanel>
</UserControl>
