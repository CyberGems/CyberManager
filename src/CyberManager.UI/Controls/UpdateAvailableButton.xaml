<UserControl x:Class="CyberManager.UI.Controls.UpdateAvailableButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             VerticalAlignment="Center"
             ToolTipService.InitialShowDelay="300"
             ToolTipService.BetweenShowDelay="0"
             ToolTipService.ShowDuration="8000"
             ToolTipService.Placement="Bottom"
             ToolTipService.VerticalOffset="6">
    <Button x:Name="PillButton"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            FocusVisualStyle="{x:Null}"
            AutomationProperties.AutomationId="UpdateAvailableButton"
            Click="PillButton_Click"
            MouseEnter="PillButton_MouseEnter"
            MouseLeave="PillButton_MouseLeave"
            GotKeyboardFocus="PillButton_GotKeyboardFocus"
            LostKeyboardFocus="PillButton_LostKeyboardFocus">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter/>
            </ControlTemplate>
        </Button.Template>
        <Border x:Name="PillBorder"
                Background="{DynamicResource CardSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- The wording is clipped to zero width at rest and only revealed on hover, so the
                     pill reads as a single icon until the pointer asks for the label. The padding
                     lives on the TextBlock (not a margin) so the measured width the animation
                     targets includes it and the text is never clipped once fully expanded. -->
                <Grid x:Name="LabelWrapper" Width="0" Opacity="0" ClipToBounds="True">
                    <TextBlock x:Name="LabelText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               TextAlignment="Left"
                               TextWrapping="NoWrap"
                               Padding="12,0,6,0"
                               VerticalAlignment="Center"/>
                </Grid>
                <Border x:Name="ArrowBox" Background="Transparent" SnapsToDevicePixels="True">
                    <!-- Down arrow: "a newer version is available below/behind this control". -->
                    <Path x:Name="ArrowIcon"
                          Data="M 11 3.5 L 11 14.5 M 6.5 10 L 11 14.5 L 15.5 10"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="11"
                          Height="12"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Button>
</UserControl>
